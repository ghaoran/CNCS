# CNCS 编辑器配置
# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{cpp,hpp,h,c}]
indent_style = space
indent_size = 4

[*.{md,txt,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.{bat,ps1}]
indent_style = space
indent_size = 4

[*.{rc,rc2}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4